# --- AutoFlow backend ---
# none | anthropic | openai | ollama   (none = rules-only extraction, works offline)
LLM_PROVIDER=none
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# sqlite:///./autoflow.db  (default)  |  postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./autoflow.db

# Token required on every /api/* call from the admin dashboard (header: X-Admin-Token)
ADMIN_TOKEN=change-me-admin
# Comma-separated origins allowed to call the API (your Vercel / Netlify URL)
CORS_ORIGINS=http://localhost:5173

# Seed demo data on first start
SEED_DEMO=true
